# Copy to .env.local for local development (`npm run dev`), and add the same
# variables in Cloudflare → Workers & Pages → <project> → Settings → Variables and Secrets.
# VITE_* values are baked into the site at build time, so a change needs a redeploy.
# Every VITE_* variable is optional; the defaults are in src/content/site.ts.

# --- Brand ------------------------------------------------------------------
# One-word brand used throughout the copy ("Diadem handles…", "Diadem Premium")
# VITE_BRAND=Diadem
# Trading name shown in titles and the footer
# VITE_SITE_NAME=Diadem & Co
# VITE_LEGAL_NAME=Diadem Strategies Incorporated
# VITE_TAGLINE=Your Financial Ecosystem, Unified
# Meta description for search and social previews
# VITE_SITE_DESCRIPTION=

# Logos as public URLs: put the files in public/ (e.g. public/brand/logo.svg).
# Leave unset to use the bundled Diadem logos. Favicons are the files in public/.
# VITE_LOGO_LIGHT=/brand/logo.svg
# VITE_LOGO_DARK=/brand/logo-on-dark.svg
# Icon-only mark at the centre of the hero orbit
# VITE_LOGO_MARK=/brand/mark.svg
# Small tag beside the logo; leave it empty (VITE_LOGO_TAG=) to hide it
# VITE_LOGO_TAG=Advisors

# --- Colours -------------------------------------------------------------------
# Hex colours overriding src/theme/palette.ts. They reach the CSS as :root
# variables, the Lottie animations (regenerated on every build) and the browser
# theme colour. brand = the dark navy scale, gold = the accent, surface/card =
# light backgrounds, ink = text on light, on-dark = text on dark (never white).
# VITE_THEME_BRAND_950=#0a1628
# VITE_THEME_BRAND_900=#0f1e35
# VITE_THEME_BRAND_800=#1a2f4e
# VITE_THEME_BRAND_700=#27416a
# VITE_THEME_GOLD_300=#e3cf8f
# VITE_THEME_GOLD_400=#d4aa4a
# VITE_THEME_GOLD_500=#c9a84c
# VITE_THEME_GOLD_600=#a8892f
# VITE_THEME_SURFACE=#f5f1e9
# VITE_THEME_SURFACE_ALT=#eae3d4
# VITE_THEME_CARD=#f0e9dc
# VITE_THEME_CARD_DARK=#16294a
# VITE_THEME_INK=#1b2433
# VITE_THEME_INK_MUTED=#4a5568
# VITE_THEME_ON_DARK=#c3ccda
# VITE_THEME_ON_DARK_MUTED=#8d9ab0

# --- URLs and contact ---------------------------------------------------------
# Canonical origin of this site (canonical links, Open Graph, sitemap)
# VITE_SITE_URL=https://advisors.thediadem.ca
# The client-facing site, linked from the footer
# VITE_MAIN_SITE_URL=https://www.thediadem.ca
# VITE_LOCATION=Calgary, Alberta, Canada
# VITE_CONTACT_PHONE=1-587-316-1691
# VITE_CONTACT_EMAIL=contactus@diadem.co

# Override where the application form posts. Defaults to /api/apply.
# VITE_APPLY_ENDPOINT=

# --- Server only (used by functions/api/apply.ts). Never prefix these with VITE_. ---
# GoHighLevel → Settings → Private Integrations → token with
# "View Contacts" and "Edit Contacts" scopes
GHL_API_TOKEN=
# Sub-account (location) ID, from the GoHighLevel URL: /v2/location/<ID>/...
GHL_LOCATION_ID=
# Optional: extra comma-separated tags added to every advisor application
# GHL_TAGS=advisor-application
